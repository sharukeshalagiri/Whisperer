{
  "name": "whisperer",
  "version": "0.2.0-beta.1",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "out/main/index.js",
  "description": "Self-hosted, privacy-first desktop dictation and meeting notes, with optional on-device speech recognition",
  "homepage": "https://github.com/sharukeshalagiri/Whisperer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sharukeshalagiri/Whisperer.git"
  },
  "bugs": {
    "url": "https://github.com/sharukeshalagiri/Whisperer/issues"
  },
  "license": "MIT",
  "desktopName": "whisperer.desktop",
  "author": {
    "name": "Sharukesh Alagiri",
    "url": "https://github.com/sharukeshalagiri"
  },
  "scripts": {
    "server": "uv run --locked --all-packages uvicorn whisperer_api.main:app --host 0.0.0.0 --port 4318",
    "api:generate": "node tools/generate-api-client.mjs",
    "desktop": "electron .",
    "desktop:dev": "electron-vite dev",
    "build": "npm run build:desktop",
    "build:desktop": "electron-vite build",
    "desktop:test": "vitest run --config vitest.config.ts && node --test src/desktop/main/platform/PlatformService.test.cjs src/desktop/main/platform/HoldShortcutService.test.cjs",
    "desktop:typecheck": "tsc --noEmit --project tsconfig.main.json && tsc --noEmit --project tsconfig.preload.json && tsc --noEmit --project tsconfig.renderer.json",
    "desktop:lint": "eslint --max-warnings=0 src/desktop",
    "desktop:format": "prettier --check src/desktop/shared src/desktop/preload electron.vite.config.ts tsconfig*.json",
    "dist:linux": "npm run build:desktop && electron-builder --linux deb --x64 --publish never",
    "dist:windows": "npm run build:desktop && electron-builder --win nsis --x64 --publish never",
    "dist:macos": "npm run build:desktop && electron-builder --mac dmg --arm64 --x64 --publish never",
    "dist:macos:zip": "npm run build:desktop && electron-builder --mac zip --arm64 --publish never"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.64.0",
    "@swc/core": "1.16.18",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "lucide-react": "1.55.0",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "heat-graph": "0.0.25",
    "react-markdown": "10.1.0",
    "uiohook-napi": "1.5.5",
    "zod": "4.6.7"
  },
  "build": {
    "appId": "ai.whisperer.private",
    "productName": "Whisperer",
    "executableName": "whisperer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/main/**/*",
      "out/preload/**/*",
      "out/renderer/**/*",
      "src/desktop/assets/**/*",
      "package.json",
      "!node_modules/better-sqlite3/deps/**/*",
      "!node_modules/better-sqlite3/src/**/*",
      "!node_modules/better-sqlite3/build/**/*",
      "!node_modules/zod/src/**/*",
      "!node_modules/**/tests/**/*",
      "!node_modules/**/test/**/*",
      "!node_modules/**/*.map"
    ],
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*.node",
      "node_modules/uiohook-napi/prebuilds/**/*.node"
    ],
    "extraResources": [
      {
        "from": "pyproject.toml",
        "to": "api/pyproject.toml"
      },
      {
        "from": "uv.lock",
        "to": "api/uv.lock"
      },
      {
        "from": "apps/api",
        "to": "api/apps/api",
        "filter": [
          "pyproject.toml",
          "src/whisperer_api/**/*.py",
          "!**/__pycache__/**"
        ]
      }
    ],
    "afterPack": "tools/after-pack.cjs",
    "publish": null,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "protocols": [
      {
        "name": "Whisperer",
        "schemes": [
          "whisperer"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "src/desktop/assets/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Record audio when you start dictation.",
        "NSAudioCaptureUsageDescription": "Capture system audio only when you start a meeting recording.",
        "NSAppleEventsUsageDescription": "Paste completed dictations into your active application when enabled."
      }
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Utility",
      "executableName": "whisperer",
      "syncDesktopName": true,
      "icon": "src/desktop/assets/icon.png",
      "maintainer": "Sharukesh Alagiri <188652148+sharukeshalagiri@users.noreply.github.com>",
      "synopsis": "Self-hosted dictation and notes",
      "mimeTypes": [
        "x-scheme-handler/whisperer"
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ],
      "recommends": [
        "xdotool"
      ]
    },
    "win": {
      "signExecutable": false,
      "icon": "src/desktop/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
