# Example configuration for Docker Compose (`make api-up`, `make stack-up`).
#
# Copy to `.env` in the repository root and replace every CHANGE_ME. `.env` is
# ignored by Git; never commit real values. Every variable is optional unless
# marked REQUIRED, and the commented value is the default Compose uses.
# docs/configuration.md describes each setting in full.

# --- Network -------------------------------------------------------------------
# Host interface and port the API is published on (container port 4318).
# BIND_ADDRESS=0.0.0.0
# HOST_PORT=14318
# Host CA bundle mounted read-only into the container, for an internal OIDC CA.
# CA_BUNDLE_PATH=/etc/ssl/certs/ca-certificates.crt
# Existing Docker network your inference gateway is attached to (`make api-up`).
# GATEWAY_NETWORK=llm-network

# --- Sign-in (OpenID Connect) -------------------------------------------------
# REQUIRED for sign-in. HTTPS issuer URL used for discovery and token validation.
OIDC_ISSUER_URL=CHANGE_ME
# REQUIRED. Confidential OIDC client registered for this API.
OIDC_CLIENT_ID=CHANGE_ME
OIDC_CLIENT_SECRET=CHANGE_ME
# OIDC_SCOPES=openid email profile groups
# OIDC_GROUPS_CLAIM=groups
# Comma-separated group allowlist. Blank admits any authenticated account.
# OIDC_ALLOWED_GROUPS=
# REQUIRED. HTTPS public URL of this API, used in callbacks and metadata.
PUBLIC_URL=CHANGE_ME
# REQUIRED. Random secret of at least 32 characters that protects issued tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
TOKEN_SECRET=CHANGE_ME

# --- Inference gateway ----------------------------------------------------------
# Any OpenAI-compatible endpoint (OpenAI, LiteLLM, Ollama, speaches) reachable
# from the API container.
# GATEWAY_BASE_URL=http://litellm:4000
# Gateway credential, if it needs one. REQUIRED for the local stacks.
# GATEWAY_API_KEY=
# TRANSCRIPTION_MODEL=whisper-1
# POLISH_MODEL=gpt-4o-mini
# Optional dedicated endpoints; each uses only its own key.
# SPEECH_BASE_URL=
# SPEECH_API_KEY=
# LLM_BASE_URL=
# LLM_API_KEY=

# --- Lifetimes and timeouts ------------------------------------------------------
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=30
# DEVICE_AUTHORIZATION_MINUTES=10
# OIDC_TIMEOUT_SECONDS=5
# GATEWAY_TIMEOUT_SECONDS=10
# MEETING_GATEWAY_TIMEOUT_SECONDS=300

# --- Remote MCP endpoint (off by default) ---------------------------------------
# MCP_ENABLED=false
# HTTPS public base for MCP; defaults to PUBLIC_URL.
# MCP_PUBLIC_URL=
# A separate OIDC client for MCP. Never reuse OIDC_CLIENT_ID.
# MCP_OIDC_CLIENT_ID=CHANGE_ME
# MCP_OIDC_CLIENT_SECRET=CHANGE_ME
# Secret of at least 32 characters, different from TOKEN_SECRET.
# MCP_SIGNING_KEY=CHANGE_ME
# Comma-separated Host values and browser origins MCP accepts.
# MCP_ALLOWED_HOSTS=
# MCP_ALLOWED_ORIGINS=
# MCP_ACCESS_TOKEN_MINUTES=60

# --- Bundled inference stacks (`make stack-up STACK=cloud|cpu|nvidia|apple`) ---
# deploy/<stack>.env sets per-stack model defaults; values here override them.
# Cloud stack: provider key, passed to the API as GATEWAY_API_KEY.
# OPENAI_API_KEY=
# Local stacks: Hugging Face id of the speaches speech model.
# STT_MODEL=
# Local stacks: Ollama model tag for polish, summaries and transformations.
# POLISH_MODEL_LOCAL=
# An Ollama you already run; skips the bundled container.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# STT_MODEL_TTL=900
# OLLAMA_KEEP_ALIVE=30m
# SPEACHES_CPUS=4
