# Defaults for `make stack-up STACK=apple`. Shell variables and the root .env override them.
#
# Parakeet TDT 0.6B v3 (ONNX) on the ARM64 CPU: 25 European languages with
# automatic detection, about 3 GB of memory. For other languages use
# Systran/faster-whisper-small.
STT_MODEL=istupakov/parakeet-tdt-0.6b-v3-onnx
POLISH_MODEL_LOCAL=gemma3:1b
