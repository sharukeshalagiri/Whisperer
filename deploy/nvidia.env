# Defaults for `make stack-up STACK=nvidia`. Shell variables and the root .env override them.
#
# Parakeet TDT 0.6B v3 (ONNX) transcribes 25 European languages with automatic
# language detection and fits in about 3 GB of VRAM. Use
# Systran/faster-whisper-large-v3 when you need languages Parakeet lacks.
# Gemma 3 4B needs about 4 GB more VRAM for polish and summaries.
STT_MODEL=istupakov/parakeet-tdt-0.6b-v3-onnx
POLISH_MODEL_LOCAL=gemma3:4b
