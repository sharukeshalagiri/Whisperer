# Defaults for `make stack-up STACK=cpu`. Shell variables and the root .env override them.
#
# Whisper small (CTranslate2, int8) is the smallest model that stays usable for
# multilingual dictation on a CPU. On slow or memory-tight hosts use
# Systran/faster-whisper-base, or Systran/faster-whisper-tiny as a last resort.
# Parakeet also runs on CPU and is more accurate, but needs about 3 GB of RAM
# and a fast core count to keep up with dictation.
STT_MODEL=Systran/faster-whisper-small
POLISH_MODEL_LOCAL=gemma3:1b
